      "choices": [
        "radio/tv",
        "new car",
        "furniture/equipment",
        "used car",
        "business",
        "education",
        "repairs",
        "domestic appliance",
        "other",
        "retraining"
      ]
    },
    "credit_amount": {
      "type": "numeric",
      "min": 276.0,
